# Local development only. Never use mock auth for a shared deployment.
OOSHDAQ_AUTH_MODE=mock
OOSHDAQ_ADDR=127.0.0.1:8080
OOSHDAQ_DATA_PATH=./data/ooshdaq.sqlite

# SQLite online backups are created, verified, and retained by the serving Go
# process.
OOSHDAQ_BACKUP_DIR=./backups
OOSHDAQ_BACKUP_INTERVAL=24h
OOSHDAQ_BACKUP_RETENTION_COUNT=14

# Required when mock mode listens beyond the loopback interface.
# OOSHDAQ_ALLOW_MOCK_AUTH=true

# Optional in mock mode. Set at least 32 random bytes to preserve local mock
# sessions across restarts; when omitted, $OOSHDAQ generates an ephemeral key.
# OOSHDAQ_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Proxy-auth deployments must explicitly name trusted identity headers.
OOSHDAQ_PROXY_USER_ID_HEADER=X-Forwarded-User-ID
OOSHDAQ_PROXY_USER_NAME_HEADER=X-Forwarded-User-Name
